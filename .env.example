# Pass environment variables to npm run build. This project does not auto-load .env.
# Preview builds are noindex unless SITE_PUBLISH=true.
SITE_ORIGIN=https://agready.ai
SITE_PUBLISH=false
# Omit this variable to use the public production ID in site.config.mjs.
# An explicitly blank value disables GA. Preview builds default to blank.
# No GA script loads without a valid ID, production hostname AND visitor consent.
GA4_MEASUREMENT_ID=
# Optional Search Console URL-prefix verification meta token (not domain verification).
GOOGLE_SITE_VERIFICATION=
