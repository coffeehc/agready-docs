# Pass environment variables to npm run build. This project does not auto-load .env.
# Preview builds are noindex unless SITE_PUBLISH=true.
SITE_ORIGIN=https://agready.ai
SITE_PUBLISH=false
# Optional. No third-party analytics script loads without a valid ID AND visitor consent.
GA4_MEASUREMENT_ID=
# Optional Search Console URL-prefix verification meta token (not domain verification).
GOOGLE_SITE_VERIFICATION=
